---
layout: none
---
{
  "id": "{{ '/?app=mise' | relative_url }}",
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "description": "Recipes, meal plan, grocery list and pantry.",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#141614",
  "background_color": "#141614",
  "categories": ["food", "lifestyle"],
  "icons": [
    { "src": "{{ '/icons/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "{{ '/icons/favicon-512x512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "{{ '/icons/icon-maskable-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Recipes", "url": "{{ '/recipes/' | relative_url }}", "icons": [{ "src": "{{ '/icons/icon-192.png' | relative_url }}", "sizes": "192x192" }] },
    { "name": "Meal plan", "url": "{{ '/meal-plan/' | relative_url }}", "icons": [{ "src": "{{ '/icons/icon-192.png' | relative_url }}", "sizes": "192x192" }] },
    { "name": "Grocery list", "url": "{{ '/grocery-list/' | relative_url }}", "icons": [{ "src": "{{ '/icons/icon-192.png' | relative_url }}", "sizes": "192x192" }] },
    { "name": "Pantry", "url": "{{ '/pantry/' | relative_url }}", "icons": [{ "src": "{{ '/icons/icon-192.png' | relative_url }}", "sizes": "192x192" }] }
  ]
}
